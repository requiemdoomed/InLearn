{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "InLearn: Run the app",
      "detail": "Starts InLearn (first run downloads Maven, JavaFX and libraries)",
      "type": "shell",
      "command": "./mvnw",
      "windows": {
        "command": ".\\mvnw.cmd"
      },
      "args": [
        "javafx:run"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true,
        "clear": true
      },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "InLearn: Load demo data",
      "detail": "Fills an EMPTY database with demo accounts, courses and assignments",
      "type": "shell",
      "command": "./mvnw",
      "windows": {
        "command": ".\\mvnw.cmd"
      },
      "args": [
        "-q",
        "compile",
        {
          "value": "exec:java@seed-demo",
          "quoting": "strong"
        }
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "InLearn: Reset and reload demo data",
      "detail": "Deletes ALL InLearn data, then loads the demo data again",
      "type": "shell",
      "command": "./mvnw",
      "windows": {
        "command": ".\\mvnw.cmd"
      },
      "args": [
        "-q",
        "compile",
        {
          "value": "exec:java@seed-demo",
          "quoting": "strong"
        },
        {
          "value": "-Dexec.args=--reset",
          "quoting": "strong"
        }
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "InLearn: Create first administrator",
      "detail": "Asks for a name, email and password in the terminal",
      "type": "shell",
      "command": "./mvnw",
      "windows": {
        "command": ".\\mvnw.cmd"
      },
      "args": [
        "-q",
        "compile",
        {
          "value": "exec:java@create-admin",
          "quoting": "strong"
        }
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "InLearn: Run unit tests",
      "detail": "Runs the tests that don't need a database",
      "type": "shell",
      "command": "./mvnw",
      "windows": {
        "command": ".\\mvnw.cmd"
      },
      "args": [
        "test"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true,
        "clear": true
      },
      "problemMatcher": [],
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "InLearn: Build runnable jar",
      "detail": "Creates target/inlearn-1.0.0-all.jar",
      "type": "shell",
      "command": "./mvnw",
      "windows": {
        "command": ".\\mvnw.cmd"
      },
      "args": [
        "package",
        {
          "value": "-DskipTests",
          "quoting": "strong"
        }
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true,
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}
