<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.inlearn.ui.instructor.GradebookTabController"
      styleClass="tab-body">
    <HBox styleClass="info-banner">
        <Label text="Current grade = points earned on graded assignments ÷ points possible on graded assignments × 100. Work that hasn't been graded is left out, not counted as zero."
               wrapText="true"/>
    </HBox>
    <HBox styleClass="toolbar-row">
        <TextField fx:id="searchField" promptText="Search students" styleClass="search-field"
                   accessibleText="Search the gradebook"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="legendLabel" text="“Not graded” = submitted, awaiting feedback  ·  “—” = not submitted"
               styleClass="field-hint"/>
        <Button fx:id="exportButton" text="E_xport CSV…" onAction="#onExport"/>
    </HBox>
    <TableView fx:id="gradebookTable" VBox.vgrow="ALWAYS" accessibleText="Course gradebook"/>
</VBox>
