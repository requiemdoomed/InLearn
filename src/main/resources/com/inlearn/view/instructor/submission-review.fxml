<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.inlearn.ui.instructor.SubmissionReviewController"
      styleClass="page">

    <HBox styleClass="info-banner">
        <Label fx:id="assignmentSummary" wrapText="true"/>
    </HBox>

    <HBox spacing="18" VBox.vgrow="ALWAYS">
        <!-- Students and their submission state -->
        <VBox spacing="10" HBox.hgrow="ALWAYS" minWidth="380">
            <HBox styleClass="toolbar-row">
                <TextField fx:id="searchField" promptText="Search students" accessibleText="Search students"
                           HBox.hgrow="ALWAYS"/>
                <ComboBox fx:id="filterChoice" accessibleText="Filter submissions"/>
            </HBox>
            <TableView fx:id="submissionTable" VBox.vgrow="ALWAYS" accessibleText="Submissions">
                <columns>
                    <TableColumn fx:id="studentColumn" text="Student" prefWidth="170"/>
                    <TableColumn fx:id="statusColumn" text="Status" prefWidth="170"/>
                    <TableColumn fx:id="submittedColumn" text="Submitted" prefWidth="160"/>
                    <TableColumn fx:id="pointsColumn" text="Points" prefWidth="80"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                </columnResizePolicy>
            </TableView>
            <Label fx:id="progressLabel" styleClass="muted"/>
        </VBox>

        <!-- Selected submission and grading form -->
        <ScrollPane fitToWidth="true" prefWidth="420" minWidth="360">
            <VBox fx:id="detailPane" styleClass="card">
                <Label fx:id="detailStudentName" styleClass="section-title" text="Select a student"/>
                <Label fx:id="detailHint" text="Choose a student on the left to see their submission and grade it."
                       styleClass="muted" wrapText="true"/>

                <VBox fx:id="submissionDetails" spacing="10">
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label fx:id="detailStatusBadge"/>
                    </HBox>
                    <VBox spacing="2">
                        <Label text="File" styleClass="detail-label"/>
                        <Label fx:id="detailFileName" styleClass="detail-value" wrapText="true"/>
                    </VBox>
                    <VBox spacing="2">
                        <Label text="Submitted" styleClass="detail-label"/>
                        <Label fx:id="detailSubmittedAt" styleClass="detail-value" wrapText="true"/>
                    </VBox>
                    <Button fx:id="downloadButton" text="_Download submission" onAction="#onDownload"/>

                    <VBox styleClass="field">
                        <Label fx:id="pointsLabel" text="Points" labelFor="$pointsField" styleClass="field-label"/>
                        <TextField fx:id="pointsField" promptText="e.g. 8.5" maxWidth="160"/>
                    </VBox>
                    <VBox styleClass="field">
                        <Label text="Feedback for the student" labelFor="$feedbackArea" styleClass="field-label"/>
                        <TextArea fx:id="feedbackArea" prefRowCount="7" wrapText="true"
                                  promptText="What went well and what to improve."/>
                    </VBox>
                    <Label fx:id="gradedByLabel" styleClass="field-hint" wrapText="true"/>
                    <Label fx:id="formMessage" managed="false" visible="false"/>
                    <HBox styleClass="button-row">
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="saveGradeButton" text="_Save grade" onAction="#onSaveGrade"/>
                        <Button fx:id="saveAndNextButton" text="Save &amp; grade _next" onAction="#onSaveAndNext"
                                styleClass="primary"/>
                    </HBox>
                </VBox>
            </VBox>
        </ScrollPane>
    </HBox>
</VBox>
