<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.inlearn.ui.instructor.CourseOverviewTabController"
            fitToWidth="true">
    <VBox styleClass="tab-body">
        <VBox styleClass="card">
            <Label text="Course details" styleClass="section-title"/>
            <GridPane hgap="24" vgap="8">
                <columnConstraints>
                    <ColumnConstraints minWidth="110"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>
                <Label text="Code" styleClass="detail-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <Label fx:id="codeValue" styleClass="detail-value" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                <Label text="Term" styleClass="detail-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <Label fx:id="termValue" styleClass="detail-value" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                <Label text="Students" styleClass="detail-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <Label fx:id="studentsValue" styleClass="detail-value" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                <Label text="Status" styleClass="detail-label" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <Label fx:id="statusBadge" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
            </GridPane>
        </VBox>

        <VBox styleClass="card">
            <Label text="Course description" labelFor="$descriptionArea" styleClass="section-title"/>
            <Label text="Students see this on the course's Overview tab." styleClass="field-hint"/>
            <TextArea fx:id="descriptionArea" prefRowCount="8" wrapText="true"
                      promptText="Describe what the course covers, how it's assessed and how to get help."/>
            <Label fx:id="messageLabel" managed="false" visible="false"/>
            <HBox styleClass="button-row">
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="discardButton" text="Discard changes" onAction="#onDiscard"/>
                <Button fx:id="saveButton" text="_Save description" onAction="#onSave" styleClass="primary"/>
            </HBox>
        </VBox>
    </VBox>
</ScrollPane>
