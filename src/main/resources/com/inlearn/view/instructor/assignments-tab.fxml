<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.inlearn.ui.instructor.AssignmentsTabController"
      styleClass="tab-body">
    <HBox styleClass="toolbar-row">
        <TextField fx:id="searchField" promptText="Search assignments" styleClass="search-field"
                   accessibleText="Search assignments"/>
        <ComboBox fx:id="filterChoice" accessibleText="Filter assignments"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="newButton" text="New assignment" onAction="#onNewAssignment" styleClass="primary"/>
    </HBox>
    <TableView fx:id="assignmentTable" VBox.vgrow="ALWAYS" accessibleText="Assignments">
        <columns>
            <TableColumn fx:id="titleColumn" text="Assignment" prefWidth="220"/>
            <TableColumn fx:id="dueColumn" text="Due" prefWidth="190"/>
            <TableColumn fx:id="pointsColumn" text="Points" prefWidth="70"/>
            <TableColumn fx:id="latePolicyColumn" text="Late work" prefWidth="150"/>
            <TableColumn fx:id="submittedColumn" text="Submitted" prefWidth="100"/>
            <TableColumn fx:id="awaitingColumn" text="Grading" prefWidth="150"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
        </columnResizePolicy>
    </TableView>
    <HBox styleClass="toolbar-row">
        <Label fx:id="zoneLabel" styleClass="field-hint"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="reviewButton" text="_Review submissions" onAction="#onReview" styleClass="primary"/>
        <Button fx:id="editButton" text="_Edit" onAction="#onEdit"/>
        <Button fx:id="deleteButton" text="Delete" onAction="#onDelete" styleClass="danger-text"/>
    </HBox>
</VBox>
