<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.inlearn.ui.instructor.InstructorCourseController"
      styleClass="page">

    <HBox fx:id="archivedBanner" styleClass="warning-banner" managed="false" visible="false">
        <Label text="This course is archived, so it's read-only. You can still view everything, but nothing can be added or changed."
               wrapText="true"/>
    </HBox>

    <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
        <Tab fx:id="overviewTab" text="Overview">
            <fx:include fx:id="overviewContent" source="course-overview-tab.fxml"/>
        </Tab>
        <Tab fx:id="rosterTab" text="Roster">
            <fx:include fx:id="rosterContent" source="roster-tab.fxml"/>
        </Tab>
        <Tab fx:id="materialsTab" text="Materials">
            <fx:include fx:id="materialsContent" source="../common/materials-tab.fxml"/>
        </Tab>
        <Tab fx:id="assignmentsTab" text="Assignments">
            <fx:include fx:id="assignmentsContent" source="assignments-tab.fxml"/>
        </Tab>
        <Tab fx:id="announcementsTab" text="Announcements">
            <fx:include fx:id="announcementsContent" source="../common/announcements-tab.fxml"/>
        </Tab>
        <Tab fx:id="gradebookTab" text="Gradebook">
            <fx:include fx:id="gradebookContent" source="gradebook-tab.fxml"/>
        </Tab>
    </TabPane>
</VBox>
