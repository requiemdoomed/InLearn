<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.inlearn.ui.common.MaterialsTabController"
      styleClass="tab-body">
    <HBox styleClass="toolbar-row">
        <TextField fx:id="searchField" promptText="Search materials" styleClass="search-field"
                   accessibleText="Search materials"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="addFileButton" text="Add file…" onAction="#onAddFile" styleClass="primary"/>
        <Button fx:id="addLinkButton" text="Add web link…" onAction="#onAddLink"/>
    </HBox>
    <TableView fx:id="materialTable" VBox.vgrow="ALWAYS" accessibleText="Course materials">
        <columns>
            <TableColumn fx:id="titleColumn" text="Title" prefWidth="240"/>
            <TableColumn fx:id="typeColumn" text="Type" prefWidth="220"/>
            <TableColumn fx:id="addedColumn" text="Added" prefWidth="140"/>
            <TableColumn fx:id="addedByColumn" text="Shared by" prefWidth="150"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
        </columnResizePolicy>
    </TableView>
    <Label fx:id="descriptionLabel" styleClass="muted" wrapText="true"/>
    <HBox styleClass="toolbar-row">
        <Label fx:id="hintLabel" styleClass="field-hint" wrapText="true" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        <Button fx:id="openButton" text="_Download" onAction="#onOpen" styleClass="primary"/>
        <Button fx:id="deleteButton" text="Delete" onAction="#onDelete" styleClass="danger-text"/>
    </HBox>
</VBox>
