<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.inlearn.ui.student.StudentGradebookController"
      styleClass="page" spacing="18">
    <VBox spacing="10" prefWidth="200" maxWidth="200" minWidth="180">
        <Label text="Courses" styleClass="section-title"/>
        <ListView fx:id="courseList" VBox.vgrow="ALWAYS" accessibleText="Courses and current grades"/>
        <Label text="Only your own grades are shown." styleClass="field-hint" wrapText="true"/>
    </VBox>
    <VBox HBox.hgrow="ALWAYS" spacing="10">
        <Label fx:id="selectedCourseLabel" styleClass="section-title"/>
        <fx:include fx:id="grades" source="course-grades.fxml" VBox.vgrow="ALWAYS"/>
    </VBox>
</HBox>
