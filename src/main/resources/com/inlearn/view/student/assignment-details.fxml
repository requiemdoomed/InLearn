<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.inlearn.ui.student.AssignmentDetailsController"
            fitToWidth="true" styleClass="page-scroll">
    <VBox styleClass="page" maxWidth="960">

        <!-- Deadline, points and status -->
        <VBox styleClass="card">
            <HBox styleClass="card-header">
                <Label fx:id="titleLabel" styleClass="section-title" wrapText="true"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="statusBadge"/>
            </HBox>
            <GridPane hgap="24" vgap="8">
                <columnConstraints>
                    <ColumnConstraints minWidth="110"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>
                <Label text="Due" styleClass="detail-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <Label fx:id="dueLabel" styleClass="detail-value" wrapText="true" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                <Label text="Points" styleClass="detail-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <Label fx:id="pointsLabel" styleClass="detail-value" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                <Label text="Late work" styleClass="detail-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <Label fx:id="latePolicyLabel" styleClass="detail-value" wrapText="true" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
            </GridPane>
        </VBox>

        <VBox styleClass="card">
            <Label text="Instructions" styleClass="section-title"/>
            <Label fx:id="instructionsLabel" styleClass="body-text" wrapText="true"/>
        </VBox>

        <!-- Submission -->
        <VBox styleClass="card">
            <Label text="Your submission" styleClass="section-title"/>

            <VBox fx:id="receiptBox" styleClass="receipt" managed="false" visible="false">
                <Label fx:id="receiptHeading" styleClass="banner-title" wrapText="true"/>
                <Label fx:id="receiptFile" wrapText="true"/>
                <Label fx:id="receiptTime" wrapText="true"/>
                <Label fx:id="receiptStatus" wrapText="true"/>
            </VBox>
            <Label fx:id="noSubmissionLabel" text="You haven't submitted anything for this assignment yet." styleClass="muted"
                   wrapText="true"/>

            <HBox fx:id="downloadRow" spacing="10" alignment="CENTER_LEFT">
                <Button fx:id="downloadButton" text="Download my submission" onAction="#onDownloadOwn"/>
            </HBox>

            <VBox fx:id="submitSection" spacing="10">
                <Label fx:id="submitRules" styleClass="field-hint" wrapText="true"/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Button fx:id="chooseFileButton" text="Choose file…" onAction="#onChooseFile"/>
                    <Label fx:id="chosenFileLabel" text="No file chosen" styleClass="muted" wrapText="true"/>
                </HBox>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Button fx:id="submitButton" text="_Submit assignment" onAction="#onSubmit" styleClass="primary"/>
                    <ProgressIndicator fx:id="uploadProgress" styleClass="top-progress" visible="false"
                                       accessibleText="Uploading"/>
                    <Label fx:id="uploadStatusLabel" styleClass="muted"/>
                </HBox>
            </VBox>

            <HBox fx:id="closedBanner" styleClass="warning-banner" managed="false" visible="false">
                <Label fx:id="closedMessage" wrapText="true"/>
            </HBox>
            <Label fx:id="errorLabel" managed="false" visible="false"/>
        </VBox>

        <!-- Grade and feedback -->
        <VBox styleClass="card">
            <Label text="Grade and feedback" styleClass="section-title"/>
            <Label fx:id="gradeLabel" styleClass="grade-percentage"/>
            <Label fx:id="gradeDetailLabel" styleClass="muted" wrapText="true"/>
            <VBox fx:id="feedbackBox" styleClass="feedback-box" managed="false" visible="false">
                <Label text="Feedback from your instructor" styleClass="field-label"/>
                <Label fx:id="feedbackLabel" styleClass="body-text" wrapText="true"/>
            </VBox>
        </VBox>
    </VBox>
</ScrollPane>
