<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.inlearn.ui.student.StudentAssignmentsTabController"
      styleClass="tab-body">
    <HBox styleClass="toolbar-row">
        <TextField fx:id="searchField" promptText="Search assignments" styleClass="search-field"
                   accessibleText="Search assignments"/>
        <ComboBox fx:id="filterChoice" accessibleText="Filter assignments"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="zoneLabel" styleClass="field-hint"/>
    </HBox>
    <TableView fx:id="assignmentTable" VBox.vgrow="ALWAYS" accessibleText="Assignments">
        <columns>
            <TableColumn fx:id="titleColumn" text="Assignment" prefWidth="240"/>
            <TableColumn fx:id="dueColumn" text="Due" prefWidth="200"/>
            <TableColumn fx:id="statusColumn" text="Status" prefWidth="230"/>
            <TableColumn fx:id="scoreColumn" text="Score" prefWidth="120"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
        </columnResizePolicy>
    </TableView>
    <HBox styleClass="toolbar-row">
        <Label text="Open an assignment to read the instructions, submit your work and see feedback."
               styleClass="field-hint" wrapText="true" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        <Button fx:id="openButton" text="_Open assignment" onAction="#onOpen" styleClass="primary"/>
    </HBox>
</VBox>
