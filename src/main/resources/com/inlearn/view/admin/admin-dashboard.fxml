<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.inlearn.ui.admin.AdminDashboardController"
            fitToWidth="true" styleClass="page-scroll">
    <VBox styleClass="page">
        <VBox spacing="2">
            <Label fx:id="welcomeLabel" styleClass="section-title"/>
            <Label text="Here's an overview of InLearn. Counts include active accounts, active courses and current enrollments only."
                   styleClass="section-subtitle" wrapText="true"/>
        </VBox>

        <FlowPane hgap="16" vgap="16">
            <VBox styleClass="stat-card">
                <Region styleClass="stat-card-accent"/>
                <Label fx:id="activeStudentsValue" text="—" styleClass="stat-value"/>
                <Label text="Active students" styleClass="stat-label"/>
            </VBox>
            <VBox styleClass="stat-card">
                <Region styleClass="stat-card-accent"/>
                <Label fx:id="activeInstructorsValue" text="—" styleClass="stat-value"/>
                <Label text="Active instructors" styleClass="stat-label"/>
            </VBox>
            <VBox styleClass="stat-card">
                <Region styleClass="stat-card-accent"/>
                <Label fx:id="activeCoursesValue" text="—" styleClass="stat-value"/>
                <Label text="Active courses" styleClass="stat-label"/>
            </VBox>
            <VBox styleClass="stat-card">
                <Region styleClass="stat-card-accent"/>
                <Label fx:id="activeEnrollmentsValue" text="—" styleClass="stat-value"/>
                <Label text="Active enrollments" styleClass="stat-label"/>
            </VBox>
        </FlowPane>

        <VBox styleClass="card">
            <Label text="Quick actions" styleClass="section-title"/>
            <Label text="Accounts are created here — there is no public registration. Share the temporary password with the new user privately."
                   wrapText="true" styleClass="muted"/>
            <HBox spacing="10">
                <Button text="Add a _user" onAction="#onAddUser" styleClass="primary"/>
                <Button text="Create a _course" onAction="#onCreateCourse"/>
                <Button text="Manage _enrollments" onAction="#onManageEnrollments"/>
            </HBox>
        </VBox>
    </VBox>
</ScrollPane>
