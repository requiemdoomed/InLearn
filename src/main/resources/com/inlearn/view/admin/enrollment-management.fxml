<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.inlearn.ui.admin.EnrollmentManagementController"
      styleClass="page">

    <HBox styleClass="toolbar-row">
        <Label text="Course" labelFor="$courseChoice" styleClass="field-label"/>
        <ComboBox fx:id="courseChoice" prefWidth="420" promptText="Choose a course" accessibleText="Course"/>
        <Label fx:id="courseStatusNote" styleClass="lock-note" wrapText="true"/>
    </HBox>

    <HBox spacing="18" VBox.vgrow="ALWAYS">
        <!-- Current enrollments -->
        <VBox styleClass="card" HBox.hgrow="ALWAYS">
            <HBox styleClass="card-header">
                <Label text="Enrolled students" styleClass="section-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="enrolledCountLabel" styleClass="muted"/>
            </HBox>
            <TableView fx:id="enrollmentTable" VBox.vgrow="ALWAYS" accessibleText="Enrollments">
                <columns>
                    <TableColumn fx:id="studentNameColumn" text="Student" prefWidth="170"/>
                    <TableColumn fx:id="studentEmailColumn" text="Email" prefWidth="200"/>
                    <TableColumn fx:id="enrollmentStatusColumn" text="Status" prefWidth="100"/>
                    <TableColumn fx:id="enrolledAtColumn" text="Enrolled" prefWidth="120"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                </columnResizePolicy>
            </TableView>
            <HBox styleClass="toolbar-row">
                <Label text="Withdrawing keeps the student's submissions and grades on record." styleClass="field-hint"
                       wrapText="true" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Button fx:id="withdrawButton" text="_Withdraw student" onAction="#onWithdraw" styleClass="danger-text"/>
            </HBox>
        </VBox>

        <!-- Add students -->
        <VBox styleClass="card" prefWidth="360" minWidth="300">
            <Label text="Add students" styleClass="section-title"/>
            <TextField fx:id="studentSearchField" promptText="Search students (Ctrl+F)" accessibleText="Search students"/>
            <ListView fx:id="availableStudentsList" VBox.vgrow="ALWAYS" accessibleText="Students who can be enrolled"/>
            <Label text="Hold Ctrl (or Cmd) or Shift to select several students." styleClass="field-hint" wrapText="true"/>
            <Button fx:id="enrollButton" text="E_nroll selected" onAction="#onEnroll" styleClass="primary"
                    maxWidth="Infinity"/>
        </VBox>
    </HBox>
</VBox>
