<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.inlearn.ui.admin.UserManagementController"
      styleClass="page">

    <HBox styleClass="toolbar-row">
        <TextField fx:id="searchField" promptText="Search by name or email (Ctrl+F)" styleClass="search-field"
                   accessibleText="Search users"/>
        <ComboBox fx:id="roleFilter" accessibleText="Filter by role"/>
        <ComboBox fx:id="statusFilter" accessibleText="Filter by status"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="_New user" onAction="#onNewUser" styleClass="primary"/>
    </HBox>

    <TableView fx:id="userTable" VBox.vgrow="ALWAYS" accessibleText="Users">
        <columns>
            <TableColumn fx:id="nameColumn" text="Name" prefWidth="200"/>
            <TableColumn fx:id="emailColumn" text="Email" prefWidth="240"/>
            <TableColumn fx:id="roleColumn" text="Role" prefWidth="120"/>
            <TableColumn fx:id="statusColumn" text="Status" prefWidth="110"/>
            <TableColumn fx:id="lastSignInColumn" text="Last sign-in" prefWidth="200"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
        </columnResizePolicy>
    </TableView>

    <HBox styleClass="toolbar-row">
        <Label fx:id="countLabel" styleClass="muted"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="editButton" text="_Edit" onAction="#onEdit"/>
        <Button fx:id="statusButton" text="Deactivate" onAction="#onToggleStatus"/>
        <Button fx:id="deleteButton" text="Delete" onAction="#onDelete" styleClass="danger-text"/>
    </HBox>
</VBox>
