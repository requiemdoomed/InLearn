<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.inlearn.ui.admin.CourseManagementController"
      styleClass="page">

    <HBox styleClass="toolbar-row">
        <TextField fx:id="searchField" promptText="Search code, title, term or instructor (Ctrl+F)"
                   styleClass="search-field" accessibleText="Search courses"/>
        <ComboBox fx:id="statusFilter" accessibleText="Filter by status"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="_New course" onAction="#onNewCourse" styleClass="primary"/>
    </HBox>

    <TableView fx:id="courseTable" VBox.vgrow="ALWAYS" accessibleText="Courses">
        <columns>
            <TableColumn fx:id="codeColumn" text="Code" prefWidth="110"/>
            <TableColumn fx:id="titleColumn" text="Title" prefWidth="260"/>
            <TableColumn fx:id="termColumn" text="Term" prefWidth="120"/>
            <TableColumn fx:id="instructorColumn" text="Instructor" prefWidth="180"/>
            <TableColumn fx:id="studentsColumn" text="Students" prefWidth="90"/>
            <TableColumn fx:id="statusColumn" text="Status" prefWidth="110"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
        </columnResizePolicy>
    </TableView>

    <HBox styleClass="toolbar-row">
        <Label fx:id="countLabel" styleClass="muted"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="enrollmentsButton" text="Manage enrollments" onAction="#onManageEnrollments"/>
        <Button fx:id="editButton" text="_Edit" onAction="#onEdit"/>
        <Button fx:id="archiveButton" text="Archive" onAction="#onToggleArchive"/>
        <Button fx:id="deleteButton" text="Delete" onAction="#onDelete" styleClass="danger-text"/>
    </HBox>
</VBox>
